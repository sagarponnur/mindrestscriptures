---
import { emotions } from '../data/emotions.js';

// 1. Get the slug directly from the URL in SSR mode
const { slug } = Astro.params;

// 2. Find the matching emotion in your data file
const emotion = emotions.find(e => e.name.toLowerCase().replace(/\s+/g, '-') === slug);

// 3. Fallback: If someone types a broken URL, send them to the homepage safely
if (!emotion) {
  return Astro.redirect('/');
}
