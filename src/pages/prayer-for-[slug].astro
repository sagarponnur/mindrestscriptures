---
// src/pages/prayer-for-[slug].astro
import { emotions } from '../data/emotions.js';

export const prerender = true;

export function getStaticPaths() {
  return emotions.map(e => ({
    params: { slug: e.name.toLowerCase().replace(/\s+/g, '-') },
    props: { emotion: e },
  }));
}

const { slug } = Astro.params;
const emotion = Astro.props.emotion || emotions.find(e => e.name.toLowerCase().replace(/\s+/g, '-') === slug);

if (!emotion) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Prayer for {emotion.name} | MindRest Scriptures</title>
    <style>
      /* Loading Animation */
      @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
      .spinner { width: 40px; height: 40px; border: 4px solid #b7e4c7; border-top: 4px solid #40916c; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 15px auto; }
      /* Prayer Box Styling */
      .prayer-box { background: #f9fbf9; border: 1px solid #d8eadd; border-radius: 12px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); color: #2d3748; }
    </style>
  </head>
  <body style="font-family: sans-serif; text-align: center; padding: 2rem;">
    
    <img src="/logo.png" alt="MindRest Scriptures Logo" style="max-width: 250px; margin: 0 auto 10px auto; display: block;" />
    <p style="font-style: italic; color: #40916c; margin-bottom: 30px; font-size: 1.1rem;">
      "Find peace for your mind, rooted in His word."
    </p>

    <h1>Prayer for Feeling {emotion.name} {emotion.emoji}</h1>
    <button id="generate-btn" data-emotion="{emotion.name}" style="padding: 10px 20px; background-color: #40916c; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 1rem; transition: opacity 0.3s;">
      Generate Prayer
    </button>

    <!-- Loading State with Animation -->
    <div id="loading" style="display: none; margin-top: 40px;">
      <div class="spinner"></div>
      <p style="color: #40916c; font-style: italic;">Reflecting and generating your audio...</p>
    </div>

    <!-- Generated Text Box (Hidden initially) -->
    <div id="prayer-text-container" style="display: none; margin-top: 30px; font-size: 1.15rem; line-height: 1.8; max-width: 600px; margin-left: auto; margin-right: auto; white-space: pre-wrap; text-align: left;" class="prayer-box"></div>

    <!-- Hidden Audio Player -->
    <div id="audio-container" style="display: none; margin-top: 30px; text-align: center;">
      <p style="font-size: 0.9rem; color: #40916c; margin-bottom: 8px;">Listen to your prayer:</p>
      <audio id="prayer-audio" controls style="width: 100%; max-width: 300px;"></audio>
    </div>

    <footer style="margin-top: 50px; padding-bottom: 20px; text-align: center; width: 100%;">
      <div style="display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 15px;">
        <a href="/directory" style="color: #52b788; text-decoration: none; font-size: 0.9rem;">Browse all emotions</a>
        <span style="color: #b7e4c7; font-size: 0.9rem;">|</span>
        <a href="https://rzp.io/rzp/RrXZMZu" target="_blank" style="color: #40916c; text-decoration: none; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
          <span>☕</span> Support this project ($5)
        </a>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('generate-btn');
      const loading = document.getElementById('loading');
      const textContainer = document.getElementById('prayer-text-container');
      const audioContainer = document.getElementById('audio-container');
      const prayerAudio = document.getElementById('prayer-audio');

      btn.addEventListener('click', async () => {
        const emotion = btn.getAttribute('data-emotion');
        
        // Hide the box and player, show the loading spinner
        textContainer.style.display = 'none';
        audioContainer.style.display = 'none';
        loading.style.display = 'block';
        
        btn.disabled = true;
        btn.style.opacity = '0.7'; // Dim button while loading

        try {
          const response = await fetch('https://yanissesanabria.com/api/generate.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ emotion: emotion })
          });
          
          const data = await response.json();
          
          // Hide loading spinner, restore button
          loading.style.display = 'none';
          btn.disabled = false;
          btn.style.opacity = '1';
          
          // Inject text and reveal the styled box
          textContainer.innerText = data.text;
          textContainer.style.display = 'block';

          // Inject audio and reveal player
          prayerAudio.src = data.audio_url;
          audioContainer.style.display = 'block';
          
        } catch (error) {
          console.error("Error generating prayer:", error);
          loading.innerHTML = '<p style="color: #d90429; font-weight: bold;">Error connecting to server. Please try again.</p>';
          btn.disabled = false;
          btn.style.opacity = '1';
        }
      });
    </script>
  </body>
</html>