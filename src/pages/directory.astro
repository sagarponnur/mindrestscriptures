---
// src/pages/directory.astro
import { emotions } from '../data/emotions.js';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Browse All Emotions | MindRest Scriptures</title>
    <style>
      /* Emotion Grid Styling */
      .emotion-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        max-width: 800px;
        margin: 30px auto;
        padding: 0 20px;
      }
      .emotion-card {
        background: #f9fbf9;
        border: 1px solid #d8eadd;
        border-radius: 8px;
        padding: 15px;
        text-decoration: none;
        color: #2d3748;
        font-weight: bold;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }
      .emotion-card:hover {
        background: #eef7f1;
        border-color: #b7e4c7;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
      }
      
      /* Navigation Bar Styling */
      .nav-links {
        margin-top: 25px;
        text-align: center;
      }
      .nav-links a {
        color: #40916c;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .nav-links a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body style="font-family: sans-serif; text-align: center; padding: 2rem;">
    
    <!-- Branding -->
    <img src="/logo.png" alt="MindRest Scriptures Logo" style="max-width: 250px; margin: 0 auto 10px auto; display: block;" />
    <p style="font-style: italic; color: #40916c; margin-bottom: 30px; font-size: 1.1rem;">
      "Find peace for your mind, rooted in His word."
    </p>

    <h1 style="color: #2d3748; font-size: 1.8rem; margin-bottom: 20px;">Browse All Emotions</h1>
    
    <!-- Dynamic Emotion Grid -->
    <div class="emotion-grid">
      {emotions.map(emotion => (
        <a href={`/prayer-for-${emotion.name.toLowerCase().replace(/\s+/g, '-')}`} class="emotion-card">
          <span>{emotion.name}</span>
          <span>{emotion.emoji}</span>
        </a>
      ))}
    </div>

    <!-- Footer -->
    <footer style="margin-top: 50px; padding-bottom: 20px; text-align: center; width: 100%;">
      <div style="display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 15px;">
        <a href="https://rzp.io/rzp/RrXZMZu" target="_blank" style="color: #40916c; text-decoration: none; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
          <span>☕</span> Support this project ($5)
        </a>
      </div>
      
      <div class="nav-links">
        <a href="/">&larr; Back to Home</a>
      </div>
    </footer>

  </body>
</html>